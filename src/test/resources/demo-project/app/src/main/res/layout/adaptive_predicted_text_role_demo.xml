<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/title_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/title_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Let us begin"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/body_one"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This is the first description paragraph."
        android:textSize="16sp"
        android:textStyle="normal"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/body_two"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This is the second description paragraph."
        android:textSize="16sp"
        android:textStyle="normal"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/body_outlier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This body text intentionally breaks the dominant body style."
        android:textSize="16sp"
        android:textStyle="italic"
        android:fontFamily="serif" />
</LinearLayout>
